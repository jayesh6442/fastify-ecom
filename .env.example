# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecom
DB_PASSWORD=ecom
DB_NAME=ecom

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Razorpay (India payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin registration (required to register admin accounts)
ADMIN_REGISTRATION_SECRET=

# Server
PORT=3000
HOST=0.0.0.0

# Optional: Redis (falls back to in-memory cache if unset)
# REDIS_URL=redis://localhost:6379

# Optional: Logging
# LOG_LEVEL=info
# NODE_ENV=development

# Optional: Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
